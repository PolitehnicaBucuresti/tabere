generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  parentName      String   @db.VarChar(120)
  phone           String   @db.VarChar(40)
  email           String   @db.VarChar(254)
  childName       String   @db.VarChar(120)
  age             Int
  school          String   @db.VarChar(200)
  series          String   @db.VarChar(200)
  ageCategory     String   @db.VarChar(32)
  medicalInfo     String   @db.Text
  childPassions   String   @db.Text
  organizerNotes  String   @db.Text
  discountCode    String   @default("") @db.VarChar(120)
  gdprAccepted    Boolean
  waitlisted      Boolean  @default(false)
}

model NotificationRecipient {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(254)
  createdAt DateTime @default(now())
}
